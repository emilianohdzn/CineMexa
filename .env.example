# Cine Mexa · variables del backend (Supabase Edge Functions y collectors).
# NUNCA van dentro de la app iOS. Configúralas con `supabase secrets set` o en el panel de Supabase.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Sólo servidor (collectors / funciones programadas). Jamás en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedores (dejar vacío = conector deshabilitado; la app sigue funcionando)
TMDB_API_READ_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_TRENDS_API_KEY=

# Wikidata no requiere clave, pero sí un User-Agent identificable según su política.
WIKIDATA_USER_AGENT="CineMexaBot/0.1 (contacto: definir)"

# Frecuencias objetivo (cron, configurables)
SYNC_CRON_RELEASES="0 */6 * * *"
SYNC_CRON_METADATA="30 3 * * *"
SYNC_CRON_TRENDS="15 */4 * * *"
SYNC_CRON_NEWS="10 */2 * * *"
SYNC_CRON_FESTIVALS="45 */12 * * *"
SYNC_CRON_CALLS="0 6 * * *"
